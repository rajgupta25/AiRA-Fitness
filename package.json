{
  "name": "aira-workout-harness-starter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "npm run build && node --env-file-if-exists=.env dist/server/main.js",
    "dev": "npm start",
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test --test-timeout=10000 tests/*.test.mjs",
    "test:ui": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
